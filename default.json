{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "renovate"
  ],
  "timezone": "Europe/Oslo",
  "schedule": [
    "* 0-6 * * 1-5"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "14 days",
  "vulnerabilityAlerts": {
    "addLabels": [
      "security"
    ],
    "minimumReleaseAge": null
  },
  "prCreation": "immediate",
  "semanticCommits": "enabled",
  "internalChecksFilter": "strict",
  "branchPrefix": "deps-",
  "lockFileMaintenance": {
    "enabled": true
  },
  "major": {
    "automerge": false
  },
  "minor": {
    "automerge": false
  },
  "patch": {
    "automerge": true
  },
  "dependencyDashboardAutoclose": true,
  "packageRules": [
    {
      "matchPackageNames": [
        "/^no\\.vy\\./",
        "/^nsbno//"
      ],
      "minimumReleaseAge": null
    },
    {
      "matchDepNames": [
        "/^github\\.com/nsbno//"
      ],
      "minimumReleaseAge": null
    },
    {
      "matchPackageNames": [
        "/^no\\.cantara\\.aws:sqs-util/"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "boto3",
        "aws-sdk",
        "/^com\\.amazonaws:aws-java-sdk-/",
        "/^com\\.amazonaws:java-sdk-/",
        "/^software\\.amazon\\.awssdk:/"
      ],
      "schedule": [
        "* 0-6 1-7 * *"
      ]
    },
    {
      "matchPackageNames": [
        "autoprefixer",
        "black",
        "flake8",
        "http-server",
        "jest-each",
        "jest",
        "prettier",
        "react",
        "react-dom",
        "semantic-release",
        "testcafe",
        "ts-jest",
        "ts-node",
        "typescript",
        "webpack-cli",
        "webpack-dev-server",
        "webpack",
        "/^@types//",
        "/^@typescript-eslint//",
        "/^tslint/",
        "/^eslint/",
        "/-loader$/",
        "/-webpack-plugin$/",
        "/^rollup/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "/^org\\.mock-server\\./"
      ],
      "groupName": "mock-server packages"
    },
    {
      "matchPackageNames": [
        "/^com\\.fasterxml\\.jackson\\./"
      ],
      "groupName": "jackson packages"
    },
    {
      "matchPackageNames": [
        "/^org\\.junit\\./"
      ],
      "groupName": "junit packages"
    },
    {
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin\\./"
      ],
      "groupName": "jetbrain kotlin packages",
      "separateMinorPatch": true
    },
    {
      "matchPackageNames": [
        "/^org\\.testcontainers\\./"
      ],
      "groupName": "testcontainers packages"
    },
    {
      "matchPackageNames": [
        "/^software\\.amazon\\.awssdk:/"
      ],
      "groupName": "aws-sdk-java-v2 monorepo"
    },
    {
      "matchPackageNames": [
        "/^io\\.arrow-kt/"
      ],
      "groupName": "arrow kt packages"
    },
    {
      "matchPackageNames": [
        "/^org\\.apache\\.kafka/"
      ],
      "groupName": "apache kafka packages"
    }
  ],
  "pin": {
    "automerge": true
  },
  "hostRules": [
    {
      "hostType": "maven",
      "matchHost": "https://nexus.common-services.vydev.io",
      "username": "github-actions-read",
      "password": "{{ secrets.NEXUS_GHA_READ_USER }}"
    }
  ]
}